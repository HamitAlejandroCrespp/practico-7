// 6. Convertir fecha a equivalente literal[cite: 2]
void LITERAL(int dia, int mes, int anio) {
    cout << dia << " de ";
    switch (mes) {
        case 1: cout << "Enero"; break;
        case 2: cout << "Febrero"; break;
        case 3: cout << "Marzo"; break;
        case 4: cout << "Abril"; break;
        case 5: cout << "Mayo"; break;
        case 6: cout << "Junio"; break;
        case 7: cout << "Julio"; break;
        case 8: cout << "Agosto"; break;
        case 9: cout << "Septiembre"; break;
        case 10: cout << "Octubre"; break;
        case 11: cout << "Noviembre"; break;
        case 12: cout << "Diciembre"; break;
        default: cout << "[Mes invalido]";
    }
    // Si el año es de dos dígitos (ej. 99), asumimos 1900. Si no, lo dejamos igual.
    int anioCompleto = (anio < 100) ? 1900 + anio : anio;
    cout << " de " << anioCompleto << endl;
}

// 7. Número combinatorio C = n! / (r! * (n-r)!)[cite: 2, 3]
long long COMBINATORIO(int n, int r) {
    if (r > n) return 0;
    return FAC(n) / (FAC(r) * FAC(n - r)); // Usando la función FAC del problema 2
}
